# ─────────────────────────────────────────────────────────────────────────────
# PaTo (Pay Together) - Docker Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# ─── 1. KONFIGURASI WEB & TUNNEL ─────────────────────────────────────────────
APP_NAME="PaTo"
APP_ENV=production

# Port lokal di server Debian yang akan di-bind oleh container web Nginx.
# Sambungkan Cloudflare Tunnel Anda ke http://localhost:80 (atau ubah jika port 80 terpakai)
APP_PORT=80

# URL Publik aplikasi Anda yang diakses oleh user lewat Cloudflare
FRONTEND_URL=https://pato.ryhndastra.site


# ─── 2. DATABASE POSTGRESQL (Supabase) ───────────────────────────────────────
# Ambil dari: Supabase Console > Project Settings > Database > Connection string > URI
# Bisa pakai port 5432 (direct) atau port 6543 (pooler)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"


# ─── 3. AUTENTIKASI & KEAMANAN ───────────────────────────────────────────────
# String rahasia acak untuk menandatangani JWT session.
# Generate acak di terminal: openssl rand -hex 32
JWT_SECRET="pato_super_secret_jwt_key_produksi_2026_rahasia_dan_panjang"

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web Application)
GOOGLE_CLIENT_ID="719565988722-k5ggk4uck65skvn506bhilpi4gv90uc2.apps.googleusercontent.com"

# Origin CORS yang diizinkan (* untuk semua atau spesifik domain)
CORS_ORIGIN=*


# ─── 4. OPSIONAL: LOCAL POSTGRESQL (Hanya jika TIDAK pakai Supabase) ──────────
# LOCAL_DB_USER=pato_user
# LOCAL_DB_PASSWORD=pato_password
# LOCAL_DB_NAME=pato_db

