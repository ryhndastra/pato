# ─────────────────────────────────────────────────────────────────────────────
# PaTo (Pay Together) - Docker Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# ─── 1. WEB & CLOUDFLARE TUNNEL ─────────────────────────────────────────────
APP_NAME="PaTo"
APP_ENV=production

# Port lokal di server Debian yang disambungkan oleh Cloudflare Tunnel.
# Di /etc/cloudflared/config.yml, arahkan ke: http://127.0.0.1:8200
APP_PORT=8200

# URL Domain publik Cloudflare Anda
FRONTEND_URL=https://pato.ryhndastra.site


# ─── 2. DATABASE POSTGRESQL (Container Lokal Docker) ─────────────────────────
# Data otomatis disimpan secara persisten di volume 'pato_pg_data'
DB_USER=pato_user
DB_PASSWORD=pato_secret_db_2026
DB_NAME=pato_db


# ─── 3. AUTENTIKASI & KEAMANAN ───────────────────────────────────────────────
# String rahasia JWT session
JWT_SECRET=16ca4840a273f7b53b98d67d61a95d2249add6df37e34b8aefa2249409819b8f3d97600b47e0a9134f624b28ef528516

# Google OAuth Client ID (Web Application) dari Google Cloud Console
GOOGLE_CLIENT_ID=719565988722-k5ggk4uck65skvn506bhilpi4gv90uc2.apps.googleusercontent.com

# Origin CORS yang diizinkan (* untuk semua atau domain spesifik)
CORS_ORIGIN=*

# ─── 4. GOOGLE GEMINI AI OCR (Multi-Key Pool) ──────────────────────────────
# Masukkan 1 atau lebih Gemini API Key (dipisah koma) dari aistudio.google.com
GEMINI_API_KEYS="AIzaSyKey1...,AIzaSyKey2..."
