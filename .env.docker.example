# ─────────────────────────────────────────────────────────────────────────────
# PaTo (Pay Together) - Docker Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

#  WEB & CLOUDFLARE TUNNEL 
APP_NAME="PaTo"
APP_ENV=production

# Port lokal di server Debian yang disambungkan oleh Cloudflare Tunnel.
# Di /etc/cloudflared/config.yml, arahkan ke: http://127.0.0.1:8200
APP_PORT=

# URL Domain publik
FRONTEND_URL=

# Database
DB_USER=
DB_PASSWORD=
DB_NAME=


# Jwt token
JWT_SECRET=

# Google OAuth Client ID (Web Application)
GOOGLE_CLIENT_ID=

# Origin CORS yang diizinkan 
CORS_ORIGIN=*

# GOOGLE GEMINI AI OCR (Multi-Key Pool)
# Masukkan 1 atau lebih Gemini API Key (dipisah koma) dari aistudio.google.com
GEMINI_API_KEYS=
