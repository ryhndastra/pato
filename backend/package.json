{
  "name": "pato-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/app.ts --bundle --platform=node --target=node20 --format=esm --external:pg-native --outfile=app.js && cp app.js index.js",
    "start": "node index.js",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
