# Supabase > Project Settings > Database > Connection string > URI
# (the direct connection, port 5432 - this is a long-running server, not
# a serverless function, so the pgbouncer pooler isn't needed)
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

PORT=4000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Any long random string - signs the session JWT. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Only the Client ID is needed - this flow
# verifies Google's ID token server-side, no client secret involved.
GOOGLE_CLIENT_ID=
